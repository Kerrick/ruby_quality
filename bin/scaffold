#!/usr/bin/env ruby
# frozen_string_literal: true

#--
# SPDX-FileCopyrightText: 2026 Kerrick Long <me@kerricklong.com>
# SPDX-License-Identifier: AGPL-3.0-or-later
#++

# Renders ruby_quality templates into a target repo.
#
#   bin/scaffold GEM_NAME [--dir PATH] [--author NAME] [--email EMAIL]
#                        [--license ID] [--description TEXT]
#                        [--ruby-quality PATH] [--rust] [--dry-run] [--update]
#
# Scaffold mode writes every template. Pure-Ruby projects are the default;
# pass --rust to opt into the RbSys native-extension Rakefile, Gemfile, and
# Rust quality gates. Skeleton files (gemspec, lib/, sig/, test/, exe/,
# CHANGELOG.md) are only written when missing, never overwritten.
# Update mode (used by bin/propagate) re-renders only SHARED_FILES, diffing
# before overwrite. --dry-run previews without writing.

require "erb"
require "fileutils"
require "optparse"
require "pathname"

RUBY_QUALITY_ROOT = Pathname.new(__dir__).join("..").expand_path.freeze

# Scaffold-once templates: written once, never touched by bin/propagate.
SCAFFOLD_ONCE = %w[
  AGENTS.md.erb
  Rakefile.erb
  Gemfile.erb
  REUSE.toml.erb
  bin/console.erb
  gitignore.erb
  tasks/rbs_exceptions.rb.erb
  tasks/clippy_exceptions.rb.erb
].freeze

# Shared templates: safe to re-render into consumers on every propagate.
SHARED = %w[
  rubocop.yml.erb
  Steepfile.erb
  mise.toml.erb
  pre-commit-config.yaml.erb
  bin/setup.erb
  doc/contributors/documentation_style.md.erb
  tasks/shared/lint.rake.erb
  tasks/shared/lint.rb.erb
  tasks/shared/steep.rake.erb
  tasks/shared/rust.rake.erb
  tasks/shared/test.rake.erb
].freeze

# Skeleton files: rendered only when the target is missing, so scaffolding
# into an existing repo never clobbers hand-written code. Never propagated.
SKELETON = {
  "gemspec.erb" => ->(c) { "#{c.gem_name}.gemspec" },
  "lib/main.rb.erb" => ->(c) { "lib/#{c.require_path}.rb" },
  "lib/version.rb.erb" => ->(c) { "lib/#{c.require_path}/version.rb" },
  "sig/main.rbs.erb" => ->(c) { "sig/#{c.require_path}.rbs" },
  "sig/version.rbs.erb" => ->(c) { "sig/#{c.require_path}/version.rbs" },
  "test/helper.rb.erb" => ->(*) { "test/test_helper.rb" },
  "test/skeleton_test.rb.erb" => ->(c) { "test/#{c.gem_name}_test.rb" },
  "exe/main.erb" => ->(c) { "exe/#{c.gem_name}" },
  "changelog.erb" => ->(*) { "CHANGELOG.md" }
}.freeze

# Where each template lands in the consumer repo.
OUTPUT_FOR = {
  "rubocop.yml.erb" => ".rubocop.yml",
  "pre-commit-config.yaml.erb" => ".pre-commit-config.yaml",
  "mise.toml.erb" => "mise.toml",
  "gitignore.erb" => ".gitignore"
}.freeze

class ScaffoldConfig
  attr_accessor :gem_name, :author, :email, :license, :ruby_quality_path, :description, :rust

  def initialize
    @license = "AGPL-3.0-or-later"
    @description = ""
    @author = `git config user.name`.strip
    @email = `git config user.email`.strip
    @ruby_quality_path = RUBY_QUALITY_ROOT.to_s
    @rust = false
  end

  def module_name = gem_name.split("-").map { |s| s.split("_").map(&:capitalize).join }.join("::")
  def gem_name_upcase = gem_name.tr("-", "_").upcase
  def require_path = gem_name.tr("-", "/")
  def copyright_holder = "#{author} <#{email}>"
  def year = Time.now.year
  def ruby_quality_path = @ruby_quality_path
end

options = { dir: Dir.pwd, update: false, rust: false, dry_run: false }
OptionParser.new do |o|
  o.on("--dir PATH") { |v| options[:dir] = v }
  o.on("--author NAME") { |v| options[:author] = v }
  o.on("--email EMAIL") { |v| options[:email] = v }
  o.on("--license ID") { |v| options[:license] = v }
  o.on("--description TEXT") { |v| options[:description] = v }
  o.on("--ruby-quality PATH") { |v| options[:rq] = v }
  o.on("--rust", "Opt into the RbSys native-extension Rakefile and Rust gates") { options[:rust] = true }
  o.on("--dry-run", "Preview without writing") { options[:dry_run] = true }
  o.on("--update") { options[:update] = true }
end.parse!

config = ScaffoldConfig.new
config.gem_name = ARGV.shift or abort "Usage: scaffold GEM_NAME [options]"
config.author = options[:author] if options[:author]
config.email = options[:email] if options[:email]
config.license = options[:license] if options[:license]
config.description = options[:description] if options[:description]
config.ruby_quality_path = options[:rq] if options[:rq]
config.rust = options[:rust]

output_dir = Pathname.new(options[:dir]).join(config.gem_name)
templates_dir = RUBY_QUALITY_ROOT.join("templates")

def render(template_path, config)
  ERB.new(template_path.read, trim_mode: "-").result(config.instance_eval { binding })
end

def write_out(output_path, content, executable:, dry_run:)
  if dry_run
    puts "  Would write #{output_path}"
    return
  end
  FileUtils.mkdir_p(output_path.dirname)
  File.write(output_path, content)
  FileUtils.chmod(0o755, output_path) if executable
  puts "  Wrote #{output_path}"
end

render_list = options[:update] ? SHARED : (SHARED + SCAFFOLD_ONCE)
FileUtils.mkdir_p(output_dir) unless options[:dry_run]

render_list.each do |template_name|
  template_path = templates_dir.join(template_name)
  unless template_path.file?
    warn "  WARNING: missing template #{template_name}"
    next
  end
  output_name = OUTPUT_FOR.fetch(template_name, template_name.sub(/\.erb$/, ""))
  output_path = output_dir.join(output_name)
  content = render(template_path, config)
  executable = output_name.start_with?("bin/", "exe/")
  if options[:update] && output_path.file?
    if output_path.read == content
      puts "  Unchanged #{output_name}"
      next
    end
    puts "  Would update #{output_name} (run without --update to apply)"
    next
  end
  if output_path.file? && output_path.read == content
    puts "  Unchanged #{output_name}"
    next
  end
  if output_path.file?
    puts "  Overwriting #{output_name} (differs from template)"
  end
  write_out(output_path, content, executable: executable, dry_run: options[:dry_run])
end

unless options[:update]
  SKELETON.each do |template_name, output_for|
    template_path = templates_dir.join(template_name)
    unless template_path.file?
      warn "  WARNING: missing template #{template_name}"
      next
    end
    output_name = output_for.call(config)
    output_path = output_dir.join(output_name)
    if output_path.file?
      puts "  Exists #{output_name} (skeleton never overwrites)"
      next
    end
    content = render(template_path, config)
    executable = output_name.start_with?("bin/", "exe/")
    write_out(output_path, content, executable: executable, dry_run: options[:dry_run])
  end
end
