# URL pin. The baseline lives in ruby_quality's config/rubocop.yml and is
# fetched at lint time, so rule changes propagate with no per-repo sync.
# Works in CI and contributor clones (bundler already needs network).

inherit_from:
  - https://raw.githubusercontent.com/Kerrick/ruby_quality/main/config/rubocop.yml

AllCops:
  TargetRubyVersion: "4.0"
  Exclude:
    - "tmp/**/*"
    - "vendor/**/*"
